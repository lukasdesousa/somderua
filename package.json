{
  "name": "open-pro-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "opennextjs-cloudflare build",
    "build:next": "prisma generate && next build",
    "build:cloudflare": "pnpm run build",
    "start": "next start",
    "lint": "next lint",
    "test:payments": "node --experimental-strip-types --test tests/payment-core.test.mjs tests/mercado-pago-signature.test.mjs",
    "test:downloads": "node --experimental-strip-types --test tests/pack-downloads.test.mjs",
    "verify:r2": "node scripts/verify-r2-downloads.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "node -e \"require('fs').mkdirSync('.wrangler', { recursive: true })\" && wrangler types --env-interface CloudflareEnv .wrangler/cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.908.0",
    "@aws-sdk/s3-request-presigner": "3.908.0",
    "@headlessui/react": "^2.2.0",
    "@mercadopago/sdk-react": "^1.0.6",
    "@opennextjs/cloudflare": "^1.10.1",
    "@prisma/adapter-pg": "6.17.1",
    "@prisma/client": "^6.17.1",
    "@types/node": "^22.13.0",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "aos": "3.0.0-beta.6",
    "jose": "^6.1.0",
    "mercadopago": "^2.9.0",
    "next": "15.1.11",
    "next-sitemap": "^4.2.3",
    "pg": "8.16.3",
    "prettier": "3.6.2",
    "prisma": "^6.17.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^6.1.2",
    "typescript": "^5.7.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.0.3",
    "@types/aos": "^3.0.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.11",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.3",
    "wrangler": "^4.125.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}
