// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user_payment {
  id        String      @id @default(uuid())
  user_name  String?
  email   String?
  approved Boolean @default(false)
  mpPaymentId String?
  payment_method String?
  offerId String?
  offerName String?
  offerPriceCents Int?
  digitalProductId String?
  checkoutUrl String?
  abandonedCartEmailId String?
  abandonedCartEmailScheduledAt DateTime?
  abandonedCartEmailCanceledAt DateTime?
  abandonedCartEmailSentAt DateTime?
  abandonedCartEmailProcessingAt DateTime?
  purchaseEmailId String?
  purchaseEmailSentAt DateTime?
  purchaseEmailProcessingAt DateTime?
  createdAt DateTime @default(now())
}
