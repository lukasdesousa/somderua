// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user_payment {
  id                              String    @id @default(uuid())
  user_name                       String?
  email                           String?
  approved                        Boolean   @default(false)
  status                          String    @default("CREATED")
  statusDetail                    String?
  provider                        String    @default("MERCADO_PAGO")
  checkoutMode                    String    @default("HOSTED")
  currency                        String    @default("BRL")
  amountCents                     Int?
  mpPaymentId                     String?   @unique
  mpPreferenceId                  String?   @unique
  activeCheckoutKey               String?   @unique
  payment_method                  String?
  offerId                         String?
  offerName                       String?
  offerPriceCents                 Int?
  digitalProductId                String?
  checkoutUrl                     String?
  pixExpiresAt                    DateTime?
  lastProviderSyncAt              DateTime?
  paidAt                          DateTime?
  fulfilledAt                     DateTime?
  abandonedCartEmailId            String?
  abandonedCartEmailScheduledAt   DateTime?
  abandonedCartEmailCanceledAt    DateTime?
  abandonedCartEmailSentAt        DateTime?
  abandonedCartEmailProcessingAt DateTime?
  purchaseEmailId                 String?
  purchaseEmailSentAt             DateTime?
  purchaseEmailProcessingAt       DateTime?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @default(now()) @updatedAt
}
