{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "somderua",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "DEPLOY_TARGET": "cloudflare",
    "R2_ENDPOINT": "https://d7f0a7501928764e309dfe77c5487c4f.r2.cloudflarestorage.com",
    "R2_BUCKET": "pack"
  },
  "observability": {
    "enabled": true
  }
}
