{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "somderua",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "DEPLOY_TARGET": "cloudflare",
    "PREMIUM_PACK_GOOGLE_DRIVE_URL": "https://drive.google.com/file/d/1EEVcmdQ2VDpvkOx0sq3amwc9v-DCo4ZG/view?usp=drive_link"
  },
  "observability": {
    "enabled": true
  }
}
